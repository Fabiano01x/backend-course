LIBRARY_APP_NAME="Library API - Desenvolvimento"
LIBRARY_APP_VERSION="0.21.0"
LIBRARY_ENVIRONMENT="development"
LIBRARY_DEBUG="true"
LIBRARY_DEFAULT_PAGE_SIZE="10"
LIBRARY_MAX_PAGE_SIZE="100"
LIBRARY_ALLOWED_ORIGINS='["http://localhost:5173"]'
LIBRARY_HTTPS_ENABLED="false"
LIBRARY_DATABASE_HOST="localhost"
LIBRARY_DATABASE_PORT="5432"
LIBRARY_DATABASE_NAME="library"
LIBRARY_DATABASE_USER="library"
LIBRARY_DATABASE_PASSWORD="local-library-password"
LIBRARY_JWT_SECRET_KEY="development-only-library-api-jwt-key-change-before-production"
LIBRARY_JWT_ISSUER="urn:library-api"
LIBRARY_JWT_AUDIENCE="library-api"
LIBRARY_ACCESS_TOKEN_EXPIRE_MINUTES="15"
LIBRARY_REFRESH_TOKEN_EXPIRE_DAYS="7"
# Configure os quatro campos abaixo juntos para habilitar OpenID Connect.
# LIBRARY_OIDC_ISSUER="https://accounts.example.com"
# LIBRARY_OIDC_CLIENT_ID="library-web"
# LIBRARY_OIDC_CLIENT_SECRET="substitua-pelo-segredo-do-cliente"
# LIBRARY_OIDC_REDIRECT_URI="http://localhost:8000/auth/oidc/callback"
